# wrangler.toml.example — template for secbin's single Cloudflare Worker.
#   1. npm run kv:create                    # KV namespace (+ preview) → ids below
#   2. wrangler r2 bucket create secbin-files
#   3. wrangler secret put AUTHN / SIG / ENC  # see "Variables" below
#   4. npm run deploy, then open https://<host>/dashboard/setup
# `wrangler dev` works with the placeholder ids (KV/R2/DOs are emulated locally;
# put AUTHN, SIG and ENC in .dev.vars).
name = "secbin"
main = "src/index.js"
compatibility_date = "2025-10-11"

# ── Smart Placement ──────────────────────────────────────────────────────────
# Runs the fetch handler where it is fastest overall, which for secbin is near
# its Durable Objects (almost every API call reaches the Directory singleton).
# Static assets served without the Worker are still answered from the location
# nearest the visitor. Durable Objects place themselves; RPC is unaffected.
[placement]
mode = "smart"

# ── Workers Caching ──────────────────────────────────────────────────────────
# The default caching behaviour for HTTP responses returned by fetch handlers
# (the per-entrypoint [exports.<name>.cache] tables can override it; secbin's
# only fetch entrypoint is the default export, so none is set). With it on,
# Cloudflare consults its cache before invoking the Worker — and a response
# with no Cache-Control would be cached heuristically (RFC 9111), cookie-
# authenticated GETs included. secbin therefore opts every Worker response
# OUT: the top-level fetch handler (src/index.js) adds
# `Cloudflare-CDN-Cache-Control: no-store` to everything it returns and
# `Cache-Control: no-store` to anything without its own. Nothing the Worker
# serves is stored at the edge; see SECURITY.md ("Edge caching").
[cache]
enabled = true

# ── Static assets ────────────────────────────────────────────────────────────
# The frontend lives in public/. The Worker runs first for the API and for the
# signed-in app (/dashboard*, which it gates on a valid session); every other path
# is served straight from static assets, with a single-page-application fallback
# so /p/<id> serves the viewer (the client reads the id + fragment key).
[assets]
directory = "./public"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = [ "/", "/index.html", "/api/*", "/dashboard", "/dashboard/*" ]

# ── KV: unlimited-view notes, immutable, native TTL expiry ───────────────────
[[kv_namespaces]]
binding = "PASTES"
id = "<your-kv-namespace-id>"
preview_id = "<your-kv-preview-namespace-id>"

# ── R2: encrypted file-share chunks (ciphertext only) ────────────────────────
# Create with:  wrangler r2 bucket create secbin-files
# Recommended backstop lifecycle rule (the FileShare DO deletes objects itself):
#   wrangler r2 bucket lifecycle add secbin-files --expire-days 366 --abort-multipart-days 1
[[r2_buckets]]
binding = "FILES"
bucket_name = "secbin-files"

# ── Durable Objects ──────────────────────────────────────────────────────────
# BurnPaste  — view-limited notes (atomic open / view spend), one per id
# FileShare  — file shares: upload state, views, grants, R2 cleanup, one per id
# Directory  — accounts, sessions, limits, quotas, settings, audit (singleton)
# Guard      — brute-force tracking + IP blocks, sharded by IP hash
[[durable_objects.bindings]]
name = "BURN"
class_name = "BurnPaste"

[[durable_objects.bindings]]
name = "FILESHARE"
class_name = "FileShare"

[[durable_objects.bindings]]
name = "DIRECTORY"
class_name = "Directory"

[[durable_objects.bindings]]
name = "GUARD"
class_name = "Guard"

[[migrations]]
tag = "v1"
new_sqlite_classes = [ "BurnPaste" ]

[[migrations]]
tag = "v2"
new_sqlite_classes = [ "FileShare", "Directory", "Guard" ]

# ── Variables ────────────────────────────────────────────────────────────────
# Secrets are NOT set here — use `wrangler secret put <NAME>` (or the dashboard):
#   AUTHN  one-time owner setup / recovery token (≥ 32 chars). Delete it after
#          setup; set a NEW value to recover the owner account.
#   SIG    session-signing key, 64 hex chars   (openssl rand -hex 32)
#   ENC    session-encryption key, 64 hex chars (openssl rand -hex 32)
# Optional kill switches (plain vars, case-insensitive "true"):
#   DISABLE_BFP        disable all brute-force protection and IP rules
#   DISABLE_BFP_SETUP  disable it for /dashboard/setup only
# Optional Cloudflare Turnstile (human check on login, password changes and
# anonymous share creation) — only when BOTH are set:
#   TURNSTILE_SITEKEY  the widget's site key (public; a plain var is fine)
#   TURNSTILE_SECRET   its secret key — `wrangler secret put TURNSTILE_SECRET`
# Everything else (limits, quotas, timeouts, rate limits, viewer policy) is
# configured by the owner in the admin panel.

# ── Observability ────────────────────────────────────────────────────────────
[observability]
enabled = true
